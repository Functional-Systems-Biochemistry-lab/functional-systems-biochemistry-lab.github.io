---
// 헤더: 로고(연구실 약칭) · 메뉴 · [Join Us] 버튼 · 언어 토글 (CLAUDE.md §4, §8)
import type { Locale } from '../i18n/config';
import { locales } from '../i18n/config';
import { stripLocale, useTranslations } from '../lib/i18n';
import { shortName, site } from '../lib/site';
import { href, normalizePath } from '../lib/url';

interface Props {
  locale: Locale;
  switchPath?: string;
}
const { locale, switchPath } = Astro.props;
const t = useTranslations(locale);

const base = import.meta.env.BASE_URL || '/';
const current = normalizePath(stripLocale(Astro.url.pathname, base));
const switchTarget = switchPath ?? current;

function isActive(path: string): boolean {
  const p = normalizePath(path);
  if (p === '/') return current === '/';
  return current === p || current.startsWith(p + '/');
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={href(locale, '/')}>{shortName(locale)}</a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span>{t('common.menu')}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={t('common.menu')}>
      <ul class="site-nav__list">
        {
          site.nav.header.map((item) => (
            <li>
              <a href={href(locale, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
                {t(`nav.${item.key}`)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__actions">
        <a class="btn btn--primary btn--sm" href={href(locale, site.nav.join.path)}>{t('nav.join')}</a>
        <div class="lang-switch" aria-label={t('common.lang_switch_label')}>
          {
            locales.map((l, i) => (
              <>
                {i > 0 && <span class="lang-switch__sep" aria-hidden="true">|</span>}
                {l === locale ? (
                  <span aria-current="true">{l.toUpperCase()}</span>
                ) : (
                  <a href={href(l, switchTarget)} hreflang={l} lang={l}>
                    {l.toUpperCase()}
                  </a>
                )}
              </>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = header!.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
  }
  .brand {
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .site-nav__list {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 2px solid transparent;
  }
  .site-nav__list a:hover {
    color: var(--accent);
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--accent);
    font-weight: 700;
    border-bottom-color: var(--accent);
  }
  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .btn--sm {
    min-height: 40px;
    padding: 0 16px;
    font-size: var(--fs-small);
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
  }
  .lang-switch a,
  .lang-switch span[aria-current] {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 32px;
    justify-content: center;
    padding: 0 4px;
  }
  .lang-switch span[aria-current] {
    font-weight: 700;
    color: var(--ink);
  }
  .lang-switch a {
    color: var(--muted);
    text-decoration: none;
  }
  .lang-switch a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .lang-switch__sep {
    color: var(--line);
  }
  .nav-toggle {
    display: none;
  }

  @media (max-width: 1079px) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: 0;
    }
    .nav-toggle {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 0 12px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      font: inherit;
      font-weight: 600;
      color: var(--ink);
      cursor: pointer;
    }
    /* 햄버거 선 3개: 그림자 대신 ::before/::after 로 그립니다 (D28: box-shadow 미사용) */
    .nav-toggle__bars {
      position: relative;
      display: inline-block;
      width: 18px;
      height: 2px;
      background: currentColor;
    }
    .nav-toggle__bars::before,
    .nav-toggle__bars::after {
      content: '';
      position: absolute;
      left: 0;
      width: 18px;
      height: 2px;
      background: currentColor;
    }
    .nav-toggle__bars::before {
      top: -6px;
    }
    .nav-toggle__bars::after {
      top: 6px;
    }
    .site-nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding-bottom: 16px;
    }
    .site-header.is-open .site-nav {
      display: flex;
    }
    .site-nav__list {
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--line);
      padding-top: 8px;
    }
    .site-nav__list a {
      width: 100%;
      padding: 0 8px;
      border-bottom: 0;
      border-left: 3px solid transparent;
    }
    .site-nav__list a[aria-current='page'] {
      border-left-color: var(--accent);
    }
    .site-nav__actions {
      justify-content: space-between;
      border-top: 1px solid var(--line);
      padding-top: 12px;
    }
  }
</style>
