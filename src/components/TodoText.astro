---
// frontmatter·데이터 문자열 안의 "[TODO …]" 를 눈에 띄게 표시합니다.
// bold=true 이면 "**굵게**" 표기를 <strong> 으로 바꿉니다 (D29). HTML 은 먼저 이스케이프되므로 통과하지 않습니다.
import { boldMarkup } from '../lib/inline';

interface Props {
  text: string | null | undefined;
  bold?: boolean;
}
const { text, bold = false } = Astro.props;

const parts: { todo: boolean; text: string }[] = [];
if (text) {
  const re = /\[TODO[^\]]*\]/g;
  let last = 0;
  for (const m of text.matchAll(re)) {
    const idx = m.index ?? 0;
    if (idx > last) parts.push({ todo: false, text: text.slice(last, idx) });
    parts.push({ todo: true, text: m[0] });
    last = idx + m[0].length;
  }
  if (last < text.length) parts.push({ todo: false, text: text.slice(last) });
}
---

{
  parts.map((p) =>
    p.todo ? <mark class="todo">{p.text}</mark> : bold ? <Fragment set:html={boldMarkup(p.text)} /> : <Fragment>{p.text}</Fragment>,
  )
}
