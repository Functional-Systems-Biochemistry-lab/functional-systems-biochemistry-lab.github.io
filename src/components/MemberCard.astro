---
// 구성원 (D28, 카드 아님): 정사각 사진(없으면 사진 칸 생략) + 이름·과정·연구 주제·이메일(동의 시). 박스 없이 위 1px 구분선만.
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import { memberName, memberTopic, type MemberEntry } from '../lib/content';
import { resolveAsset, responsive } from '../lib/assets';
import { formatYearMonth, useTranslations } from '../lib/i18n';
import TodoText from './TodoText.astro';

interface Props {
  member: MemberEntry;
  locale: Locale;
  link?: string;
  compact?: boolean;
}
const { member, locale, link, compact = false } = Astro.props;
const t = useTranslations(locale);
const d = member.data;
const photo = resolveAsset(d.photo);
const name = memberName(member, locale);
const altName = locale === 'ko' ? d.name_en : d.name_ko;
const topic = memberTopic(member, locale);
const isAlumni = d.role === 'alumni';
const sizes = compact ? '160px' : '(max-width: 400px) 100vw, 260px';
---

<article class:list={['member-card', { 'member-card--compact': compact, 'member-card--nophoto': !photo }]}>
  {
    photo && (
      <div class="member-card__photo">
        <Image src={photo} alt={name} width={320} height={320} {...responsive(photo, [160, 320, 480], sizes)} />
      </div>
    )
  }
  <div class="member-card__body">
    <h3 class="member-card__name">
      {link ? <a href={link}>{name}</a> : name}
      {altName && altName !== name && <span class="member-card__alt muted"> {altName}</span>}
    </h3>
    <p class="label">{t(`members.role.${d.role}`)}</p>
    {!isAlumni && topic && <p class="member-card__topic"><TodoText text={topic} bold /></p>}
    {
      isAlumni && (
        <p class="member-card__topic small">
          {d.degree && <span>{d.degree}</span>}
          {d.left && <span class="mono"> {formatYearMonth(d.left, locale)}</span>}
          {d.current_position && (
            <>
              <br />
              {t('members.now')}: {d.current_position}
            </>
          )}
        </p>
      )
    }
    {!isAlumni && d.since && <p class="small muted mono">{t('members.since')} {formatYearMonth(d.since, locale)}</p>}
    {d.email && <p class="small"><a href={`mailto:${d.email}`}>{d.email}</a></p>}
  </div>
</article>

<style>
  .member-card {
    height: 100%;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .member-card__photo {
    aspect-ratio: 1 / 1;
    background: var(--tint);
    overflow: hidden;
    margin-bottom: 14px;
  }
  .member-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .member-card__name {
    font-size: var(--fs-h3);
    margin: 0 0 4px;
  }
  .member-card__name a {
    color: var(--ink);
    text-decoration: none;
  }
  .member-card__name a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .member-card__alt {
    font-weight: 400;
    font-size: var(--fs-small);
  }
  .member-card__topic {
    margin: 8px 0 4px;
    font-size: var(--fs-small);
  }
  .member-card p:last-child {
    margin-bottom: 0;
  }
  /* 가로형(PI): 사진 160px 정사각 왼쪽, 글 오른쪽. 위아래 1px */
  .member-card--compact {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }
  .member-card--compact .member-card__photo {
    margin-bottom: 0;
  }
  /* 사진이 없으면 사진 칸 없이 글이 전체를 씀 */
  .member-card--compact.member-card--nophoto {
    grid-template-columns: 1fr;
  }
  @media (max-width: 400px) {
    .member-card--compact {
      grid-template-columns: 1fr;
    }
  }
</style>
