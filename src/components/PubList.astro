---
// 논문 목록: 연도별 그룹, "Authors. Title. Journal Year;Vol:Pages. DOI" + 분야 칩. 멤버 굵게.
// filters=true 이면 분야별 필터 버튼(클라이언트 JS, 없어도 전체 목록이 보임)
import type { Locale } from '../i18n/config';
import { useTranslations } from '../lib/i18n';
import {
  doiUrl,
  groupByYear,
  isMemberAuthor,
  pubmedUrl,
  type Publication,
} from '../lib/publications';
import { href, withBase } from '../lib/url';

interface Props {
  publications: Publication[];
  locale: Locale;
  aliasKeys: Set<string>;
  slugs: string[];
  filters?: boolean;
  showYears?: boolean;
  id?: string;
}
const { publications, locale, aliasKeys, slugs, filters = false, showYears = true, id = 'publist' } = Astro.props;
const t = useTranslations(locale);
const groups = groupByYear(publications);
const usedSlugs = slugs.filter((s) => publications.some((p) => p.tags.includes(s)));

function sanitizeTitle(html: string): string {
  return html.replace(/<(?!\/?(i|b|em|strong|sup|sub|span)\b)[^>]*>/gi, '');
}
function pdfHref(pdf: string): string {
  return /^https?:\/\//i.test(pdf) ? pdf : withBase(pdf);
}
---

<div class="publist" data-publist id={id}>
  {
    filters && usedSlugs.length > 0 && (
      <div class="publist__filters" role="group" aria-label={t('publications.filter_label')}>
        <span class="label">{t('publications.filter_label')}</span>
        <div class="publist__chips">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">
            {t('publications.filter_all')}
          </button>
          {usedSlugs.map((s) => (
            <button type="button" class="chip" data-filter={s} aria-pressed="false">
              {t(`research.short.${s}`)}
            </button>
          ))}
        </div>
        <span
          class="publist__count mono"
          data-count
          data-template={t('publications.count')}
          data-template-one={t('publications.count_one')}
        >
          {publications.length === 1 ? t('publications.count_one') : t('publications.count', { n: publications.length })}
        </span>
      </div>
    )
  }

  {
    groups.map((g) => (
      <section class="publist__year" data-year-group>
        {showYears && <h3 class="publist__year-heading mono">{g.year || '—'}</h3>}
        <ol class="publist__items">
          {g.items.map((p) => (
            <li class="pub" data-tags={p.tags.join(' ')} id={`pub-${p.key}`}>
              <span class="pub__authors">
                {p.authors.map((a, i) => (
                  <>
                    {i > 0 && ', '}
                    {isMemberAuthor(a, aliasKeys) ? <strong>{a.display}</strong> : a.display}
                  </>
                ))}
                {p.authors.length > 0 && '. '}
              </span>
              <span class="pub__title" set:html={sanitizeTitle(p.title)} />
              {'. '}
              <span class="pub__journal">{p.journal}</span>
              {p.journal && ' '}
              <span class="pub__ref">
                {p.year || ''}
                {p.volume && `;${p.volume}`}
                {p.issue && `(${p.issue})`}
                {p.pages && `:${p.pages}`}.
              </span>
              <span class="pub__links">
                {p.impactFactor && (
                  <span class="pub__if" title={t('publications.if_title')}>
                    {t('publications.if')} {p.impactFactor}
                  </span>
                )}
                {p.doi && (
                  <a href={doiUrl(p.doi)} rel="noopener">
                    {t('publications.doi')}
                  </a>
                )}
                {p.pmid && (
                  <a href={pubmedUrl(p.pmid)} rel="noopener">
                    {t('publications.pubmed')}
                  </a>
                )}
                {p.pdf && (
                  <a href={pdfHref(p.pdf)} rel="noopener">
                    {t('publications.pdf')}
                  </a>
                )}
                {!p.doi && !p.pmid && p.url && (
                  <a href={p.url} rel="noopener">
                    Link
                  </a>
                )}
              </span>
              {p.tags.length > 0 && (
                <span class="pub__tags">
                  {p.tags.map((s) => (
                    <a class="tag" href={href(locale, `/research/${s}`)}>
                      {t(`research.short.${s}`)}
                    </a>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

{
  filters && (
    <script>
      document.querySelectorAll<HTMLElement>('[data-publist]').forEach((root) => {
        const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
        if (buttons.length === 0) return;
        const items = Array.from(root.querySelectorAll<HTMLElement>('[data-tags]'));
        const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-year-group]'));
        const countEl = root.querySelector<HTMLElement>('[data-count]');

        const apply = (tag: string) => {
          let n = 0;
          for (const li of items) {
            const tags = (li.dataset.tags || '').split(' ').filter(Boolean);
            const show = tag === 'all' || tags.includes(tag);
            li.hidden = !show;
            if (show) n++;
          }
          for (const g of groups) g.hidden = !g.querySelector('[data-tags]:not([hidden])');
          for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === tag));
          if (countEl) {
            const tpl = n === 1 ? countEl.dataset.templateOne : countEl.dataset.template;
            countEl.textContent = (tpl || '{n}').replace('{n}', String(n));
          }
        };

        for (const b of buttons) {
          b.addEventListener('click', () => {
            const tag = b.dataset.filter || 'all';
            apply(tag);
            const url = new URL(location.href);
            if (tag === 'all') url.searchParams.delete('area');
            else url.searchParams.set('area', tag);
            history.replaceState(null, '', url);
          });
        }

        const initial = new URLSearchParams(location.search).get('area');
        if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
      });
    </script>
  )
}

<style>
  /* 분야 필터 (D28): 박스 없이 아래 1px 선만. 알약 대신 밑줄 탭 — 눌린 상태는 밑줄·굵기·색으로 함께 표시 */
  .publist__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-bottom: 28px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .publist__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
  .chip {
    min-height: var(--touch);
    padding: 0 2px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .chip:hover {
    color: var(--accent);
  }
  .chip[aria-pressed='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }
  .publist__count {
    margin-left: auto;
    color: var(--muted-2);
  }
  .publist__year {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px 24px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .publist__year-heading {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--muted-2);
    margin: 0;
    line-height: 1.5;
  }
  .publist__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pub {
    padding-block: 8px;
    line-height: 1.6;
  }
  .pub + .pub {
    border-top: 1px solid var(--line);
  }
  .pub__title {
    font-weight: 600;
  }
  .pub__journal {
    font-style: italic;
  }
  .pub__links {
    display: inline-flex;
    gap: 10px;
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
  }
  .pub__if {
    color: var(--muted-2);
    white-space: nowrap;
  }
  .pub__tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-left: 8px;
    vertical-align: middle;
  }
  /* 분야 링크 (D28): 알약 대신 밑줄 있는 평문 링크 */
  .tag {
    color: var(--muted);
    font-size: 12.5px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .tag:hover {
    color: var(--accent);
    text-decoration-thickness: 2px;
  }
  @media (max-width: 640px) {
    .publist__year {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .publist__count {
      margin-left: 0;
    }
  }
</style>
