---
// 논문 목록 (CLAUDE.md §5.5, D29): 블록형 항목(PubItem) + 연도별 | 저널별 보기 전환 + 분야 필터 + 10편씩 페이지네이션.
// filters=true 이면 도구 모음(보기 탭·분야 필터·개수·페이지네이션)을 붙입니다. 동작은 모두 클라이언트 JS 이며,
// JS 가 없으면 서버가 그린 연도별 전체 목록이 그대로 보입니다. Research 상세의 관련 논문(filters=false)은 목록만 그립니다.
import type { Locale } from '../i18n/config';
import { useTranslations } from '../lib/i18n';
import { AUTHOR_FOLD_LIMIT, PUBS_PER_PAGE, groupByJournal, groupByYear, type Publication } from '../lib/publications';
import PubItem from './PubItem.astro';

interface Props {
  publications: Publication[];
  locale: Locale;
  aliasKeys: Set<string>;
  slugs: string[];
  /** 도구 모음(보기 전환·분야 필터·페이지네이션) 표시 */
  filters?: boolean;
  showYears?: boolean;
  id?: string;
}
const { publications, locale, aliasKeys, slugs, filters = false, showYears = true, id = 'publist' } = Astro.props;
const t = useTranslations(locale);
const byYear = groupByYear(publications);
const byJournal = filters ? groupByJournal(publications) : [];
const usedSlugs = slugs.filter((s) => publications.some((p) => p.tags.includes(s)));
const countText = publications.length === 1 ? t('publications.count_one') : t('publications.count', { n: publications.length });
---

<div
  class="publist"
  data-publist
  id={id}
  data-controls={filters ? '' : undefined}
  data-per-page={PUBS_PER_PAGE}
  data-author-limit={AUTHOR_FOLD_LIMIT}
  data-more={t('publications.more_authors')}
  data-less={t('publications.show_less')}
  data-prev={t('common.previous')}
  data-next={t('common.next')}
  data-page-label={t('publications.page_n')}
>
  {
    filters && (
      <div class="publist__toolbar">
        <div class="publist__row" role="group" aria-label={t('publications.view_label')}>
          <span class="label">{t('publications.view_label')}</span>
          <div class="publist__tabs">
            <button type="button" class="tab" data-view="year" aria-pressed="true">
              {t('publications.view_year')}
            </button>
            <button type="button" class="tab" data-view="journal" aria-pressed="false">
              {t('publications.view_journal')}
            </button>
          </div>
        </div>
        {usedSlugs.length > 0 && (
          <div class="publist__row" role="group" aria-label={t('publications.filter_label')}>
            <span class="label">{t('publications.filter_label')}</span>
            <div class="publist__tabs">
              <button type="button" class="chip" data-filter="all" aria-pressed="true">
                {t('publications.filter_all')}
              </button>
              {usedSlugs.map((s) => (
                <button type="button" class="chip" data-filter={s} aria-pressed="false">
                  {t(`research.short.${s}`)}
                </button>
              ))}
            </div>
          </div>
        )}
        <span
          class="publist__count mono"
          data-count
          data-template={t('publications.count')}
          data-template-one={t('publications.count_one')}
        >
          {countText}
        </span>
      </div>
    )
  }

  <div data-view-list="year">
    {
      byYear.map((g) => (
        <section class:list={['publist__group', { 'publist__group--year': showYears }]} data-group>
          {showYears && <h3 class="publist__group-heading mono">{g.year || '—'}</h3>}
          <ol class="publist__items">
            {g.items.map((p) => (
              <PubItem p={p} locale={locale} aliasKeys={aliasKeys} />
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  {
    filters && (
      <div data-view-list="journal" hidden>
        {byJournal.map((g) => (
          <section class="publist__group publist__group--journal" data-group>
            <h3 class="publist__group-heading">
              {g.journal}
              {g.impactFactor && (
                <span class="publist__group-count mono" title={t('publications.if_title')}>
                  · {t('publications.if')} {g.impactFactor}
                </span>
              )}
              <span class="publist__group-count mono">· {g.items.length}</span>
            </h3>
            <ol class="publist__items">
              {g.items.map((p) => (
                <PubItem p={p} locale={locale} aliasKeys={aliasKeys} withId={false} />
              ))}
            </ol>
          </section>
        ))}
      </div>
    )
  }

  {filters && <nav class="publist__pager" data-pager aria-label={t('publications.pagination_label')} hidden />}
</div>

<script>
  // 저자 접기 (D30): 저자가 AUTHOR_FOLD_LIMIT(data-author-limit)를 넘으면 앞 3명 · 숨은 구간의 연구실 구성원 · … · 마지막 저자만 보이고
  // "+N more" 버튼(aria-expanded)으로 펼칩니다. 서버는 전체 저자를 그리므로 JS 가 없으면 전체가 보입니다. 순서는 그대로 둡니다.
  document.querySelectorAll<HTMLElement>('[data-publist]').forEach((root) => {
    const limit = Number(root.dataset.authorLimit) || 10;
    const moreTemplate = root.dataset.more || '+{n} more';
    const lessText = root.dataset.less || 'Show less';
    root.querySelectorAll<HTMLElement>('[data-authors]').forEach((line) => {
      const authors = Array.from(line.querySelectorAll<HTMLElement>('.pub__author'));
      const last = authors[authors.length - 1];
      if (authors.length <= limit || !last) return;
      const folded = authors.slice(3, authors.length - 1).filter((el) => !el.hasAttribute('data-member'));
      if (folded.length === 0) return;
      const ellipsis = document.createElement('span');
      ellipsis.className = 'pub__ellipsis';
      ellipsis.textContent = '… ';
      last.before(ellipsis);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'pub__fold';
      const setOpen = (open: boolean) => {
        for (const el of folded) el.hidden = !open;
        ellipsis.hidden = open;
        button.textContent = open ? lessText : moreTemplate.replace('{n}', String(folded.length));
        button.setAttribute('aria-expanded', String(open));
      };
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      line.append(' ', button);
      setOpen(false);
    });
  });

  // 목록 동작 (D29): 보기 전환(연도별|저널별) · 분야 필터 · 페이지네이션. 상태는 URL 쿼리 view / area / page 에 기억합니다.
  // 필터나 보기를 바꾸면 1페이지로 돌아가고, 페이지를 넘기면 목록 맨 위로 스크롤합니다. 빈 그룹 제목은 숨깁니다.
  document.querySelectorAll<HTMLElement>('[data-publist][data-controls]').forEach((root) => {
    const perPage = Number(root.dataset.perPage) || 10;
    const lists: Record<string, HTMLElement | null> = {
      year: root.querySelector('[data-view-list="year"]'),
      journal: root.querySelector('[data-view-list="journal"]'),
    };
    const viewButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]'));
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const pager = root.querySelector<HTMLElement>('[data-pager]');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const state = { view: 'year', area: 'all', page: 1 };

    const renderPager = (pages: number) => {
      if (!pager) return;
      pager.replaceChildren();
      pager.hidden = pages <= 1;
      if (pages <= 1) return;
      const button = (text: string, page: number, opts: { current?: boolean; disabled?: boolean; label?: string } = {}) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'pager__btn';
        b.textContent = text;
        if (opts.label) b.setAttribute('aria-label', opts.label);
        if (opts.current) b.setAttribute('aria-current', 'page');
        b.disabled = !!opts.disabled;
        b.addEventListener('click', () => {
          state.page = page;
          apply(true);
        });
        return b;
      };
      const pageLabel = root.dataset.pageLabel || 'Page {n}';
      pager.append(button(root.dataset.prev || 'Previous', state.page - 1, { disabled: state.page === 1 }));
      const wanted = [1, pages, state.page - 2, state.page - 1, state.page, state.page + 1, state.page + 2].filter((n) => n >= 1 && n <= pages);
      let last = 0;
      for (const n of [...new Set(wanted)].sort((a, b) => a - b)) {
        if (n - last > 1) {
          const gap = document.createElement('span');
          gap.className = 'pager__gap';
          gap.textContent = '…';
          pager.append(gap);
        }
        pager.append(button(String(n), n, { current: n === state.page, label: pageLabel.replace('{n}', String(n)) }));
        last = n;
      }
      pager.append(button(root.dataset.next || 'Next', state.page + 1, { disabled: state.page === pages }));
    };

    const apply = (scroll = false) => {
      const active = lists[state.view] ?? lists.year;
      if (!active) return;
      for (const el of Object.values(lists)) if (el) el.hidden = el !== active;
      const items = Array.from(active.querySelectorAll<HTMLElement>('[data-tags]'));
      const matching = items.filter((li) => state.area === 'all' || (li.dataset.tags || '').split(' ').includes(state.area));
      const pages = Math.max(1, Math.ceil(matching.length / perPage));
      state.page = Math.min(Math.max(1, state.page), pages);
      const visible = new Set(matching.slice((state.page - 1) * perPage, state.page * perPage));
      for (const li of items) li.hidden = !visible.has(li);
      for (const g of active.querySelectorAll<HTMLElement>('[data-group]')) g.hidden = !g.querySelector('[data-tags]:not([hidden])');
      for (const b of viewButtons) b.setAttribute('aria-pressed', String(b.dataset.view === state.view));
      for (const b of filterButtons) b.setAttribute('aria-pressed', String(b.dataset.filter === state.area));
      if (countEl) {
        const n = matching.length;
        const tpl = n === 1 ? countEl.dataset.templateOne : countEl.dataset.template;
        countEl.textContent = (tpl || '{n}').replace('{n}', String(n));
      }
      renderPager(pages);
      const url = new URL(location.href);
      if (state.view === 'year') url.searchParams.delete('view');
      else url.searchParams.set('view', state.view);
      if (state.area === 'all') url.searchParams.delete('area');
      else url.searchParams.set('area', state.area);
      if (state.page === 1) url.searchParams.delete('page');
      else url.searchParams.set('page', String(state.page));
      history.replaceState(null, '', url);
      if (scroll) root.scrollIntoView({ block: 'start' });
    };

    for (const b of viewButtons) {
      b.addEventListener('click', () => {
        state.view = b.dataset.view || 'year';
        state.page = 1;
        apply();
      });
    }
    for (const b of filterButtons) {
      b.addEventListener('click', () => {
        state.area = b.dataset.filter || 'all';
        state.page = 1;
        apply();
      });
    }

    const q = new URLSearchParams(location.search);
    const view = q.get('view');
    if (view && lists[view]) state.view = view;
    const area = q.get('area');
    if (area && filterButtons.some((b) => b.dataset.filter === area)) state.area = area;
    const page = Number.parseInt(q.get('page') || '1', 10);
    if (Number.isFinite(page) && page > 0) state.page = page;
    apply();
  });
</script>

<style>
  /* 도구 모음 (D28·D29): 박스 없이 아래 1px 선만. 왼쪽에 보기·필터 행, 오른쪽에 개수 */
  .publist__toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 16px;
    align-items: start;
    margin-bottom: 28px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .publist__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .publist__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
  /* 보기 탭·분야 필터: 알약 대신 밑줄 탭. 눌린 상태는 밑줄·굵기·색으로 함께 표시 */
  .tab,
  .chip {
    min-height: var(--touch);
    padding: 0 2px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .tab:hover,
  .chip:hover {
    color: var(--accent);
  }
  .tab[aria-pressed='true'],
  .chip[aria-pressed='true'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }
  .publist__count {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    color: var(--muted-2);
  }
  /* 그룹: 연도별은 왼쪽에 연도, 저널별·관련 논문은 제목(있으면) 위에 */
  .publist__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px 24px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .publist__group--year {
    grid-template-columns: 96px minmax(0, 1fr);
  }
  .publist__group-heading {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--muted-2);
    margin: 0;
    line-height: 1.5;
  }
  .publist__group--journal .publist__group-heading {
    font-weight: 700;
    color: var(--ink);
  }
  .publist__group-count {
    font-weight: 500;
    color: var(--muted-2);
  }
  .publist__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 페이지네이션(스크립트가 그림): 글자 버튼, 터치 타깃 44px, 현재 페이지는 aria-current */
  .publist__pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    margin-top: 24px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .publist__pager :global(.pager__btn) {
    min-width: var(--touch);
    min-height: var(--touch);
    padding: 0 10px;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }
  .publist__pager :global(.pager__btn:hover) {
    text-decoration-thickness: 2px;
  }
  .publist__pager :global(.pager__btn[aria-current='page']) {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }
  .publist__pager :global(.pager__btn:disabled) {
    color: var(--muted-2);
    text-decoration: none;
    cursor: default;
  }
  .publist__pager :global(.pager__gap) {
    color: var(--muted-2);
    padding: 0 4px;
  }
  @media (max-width: 640px) {
    .publist__toolbar {
      grid-template-columns: 1fr;
    }
    .publist__count {
      grid-column: 1;
      grid-row: auto;
    }
    .publist__group--year {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
