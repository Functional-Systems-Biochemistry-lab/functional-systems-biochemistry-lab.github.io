---
// 배경 그림 + 부드러운 스크롤 (CLAUDE.md D26). 설정은 src/data/background.yml, 해석은 src/lib/background.ts.
//  - float : 페이지 위에 떠 있는 그림. 화면에 들어오면 서서히 나타나고, 스크롤을 살짝 늦게 따라옵니다(패럴랙스).
//  - fixed : 화면 전체 배경. 스크롤 위치(%)에 따라 서로 스며들며 바뀝니다.
//  - 마우스 휠 스크롤은 Lenis 로 부드럽게. 터치·키보드는 브라우저 기본 동작, '동작 줄이기' 설정이면 모두 끕니다.
// 그림은 장식이라 스크린리더에서 숨깁니다(aria-hidden, alt=""). 글자 뒤(z-index:-1)에만 깔립니다.
import { Image } from 'astro:assets';
import { responsive } from '../lib/assets';
import { getBackground } from '../lib/background';

interface Props {
  /** 페이지 이름(home, research, ...) — background.yml 의 pages 와 비교 */
  pageKey: string;
}
const { pageKey } = Astro.props;
const bg = getBackground(pageKey);
const render = bg.fixed.length + bg.floats.length > 0 || bg.smooth.enabled;
---

{/* JS 가 켜져 있을 때만 '나타나기' 효과를 쓰기 위한 표시. 그림이 번쩍이지 않도록 가장 먼저 실행됩니다. 4초 안에 스크립트가 준비되지 않으면 해제 */}
<script is:inline>
  (function () {
    var d = document.documentElement;
    d.classList.add('bd-js');
    setTimeout(function () {
      if (!window.__bdReady) d.classList.remove('bd-js');
    }, 4000);
  })();
</script>

{
  render && (
    <div
      class="bd-root"
      aria-hidden="true"
      data-bd-root
      data-smooth={bg.smooth.enabled ? '1' : '0'}
      data-lerp={bg.smooth.lerp}
      style={`--bd-gap:${bg.gap}vh`}
    >
      {bg.fixed.map((b) => (
        <div
          class="bd-fixed"
          data-bd="fixed"
          data-from={b.show[0]}
          data-to={b.show[1]}
          data-op={b.opacity}
          style={`--bd-fit:${b.fit};--bd-pos:${b.position};opacity:${b.show[0] <= 0 ? b.opacity : 0}`}
        >
          <Image src={b.img} alt="" loading="lazy" decoding="async" {...responsive(b.img, [960, 1600, 2400], '100vw')} />
        </div>
      ))}
      {bg.floats.map((b) => (
        <div
          class:list={['bd', `bd--${b.side}`, b.fade > 0 && 'bd--fade', b.blend === 'multiply' && 'bd--multiply', b.parallax !== 0 && 'bd--par']}
          data-bd="float"
          data-near={b.near ?? undefined}
          data-at={b.at}
          data-dy={b.dy}
          data-par={b.parallax}
          style={`--bd-size:${b.size}vw;--bd-off:${b.offset}vw;--bd-slot:${b.slot};--bd-rot:${b.rotate}deg;--bd-op:${b.opacity};--bd-fade:${b.fade}%`}
        >
          <Image
            src={b.img}
            alt=""
            class={b.flip ? 'bd__flip' : undefined}
            loading="lazy"
            decoding="async"
            {...responsive(b.img, [480, 800, 1200, 1800], `min(${b.size}vw, 960px)`)}
          />
        </div>
      ))}
    </div>
  )
}

<script>
  import Lenis from 'lenis';

  declare global {
    interface Window {
      __bdReady?: boolean;
      __lenis?: Lenis;
    }
  }

  interface Float {
    el: HTMLElement;
    near: string | null;
    at: number;
    dy: number;
    par: number;
    h: number;
    cy: number;
  }
  interface Fixed {
    el: HTMLElement;
    from: number;
    to: number;
    op: number;
  }

  const RAMP = 10; // 고정 배경이 서로 스며드는 폭(%)
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

  function start() {
    const root = document.querySelector<HTMLElement>('[data-bd-root]');
    if (!root) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches; // 손가락 터치 기기: 패럴랙스는 끊겨 보일 수 있어 생략

    // 1) 부드러운 스크롤 — 마우스 휠에만 적용
    if (root.dataset.smooth === '1' && !reduced) {
      window.__lenis = new Lenis({
        lerp: Number(root.dataset.lerp) || 0.1,
        smoothWheel: true,
        syncTouch: false,
        anchors: true, // #링크 클릭도 부드럽게 (scroll-padding-top 반영)
        allowNestedScroll: true, // 표·코드처럼 안쪽에서 스크롤되는 영역은 그대로 둠
        autoRaf: true,
      });
    }

    // 2) 배경 그림
    const num = (v: string | undefined, def = 0) => (v !== undefined && v !== '' && Number.isFinite(Number(v)) ? Number(v) : def);
    const floats: Float[] = Array.from(root.querySelectorAll<HTMLElement>('[data-bd="float"]')).map((el) => ({
      el,
      near: el.dataset.near || null,
      at: num(el.dataset.at, 0.5),
      dy: num(el.dataset.dy),
      par: reduced || coarse ? 0 : num(el.dataset.par),
      h: 0,
      cy: 0,
    }));
    const fixeds: Fixed[] = Array.from(root.querySelectorAll<HTMLElement>('[data-bd="fixed"]')).map((el) => ({
      el,
      from: num(el.dataset.from, 0),
      to: num(el.dataset.to, 100),
      op: num(el.dataset.op, 1),
    }));

    let vh = window.innerHeight;
    let docH = document.documentElement.scrollHeight;

    // near 구역 위치에 맞춰 세로 위치를 잡고, 패럴랙스 계산용 중심 높이를 저장
    const measure = () => {
      vh = window.innerHeight;
      docH = document.documentElement.scrollHeight;
      for (const f of floats) {
        const target = f.near ? document.getElementById(f.near) : null;
        if (target && target.getClientRects().length > 0) {
          const r = target.getBoundingClientRect();
          const y = r.top + window.scrollY + r.height * f.at + (f.dy * vh) / 100 - f.el.offsetHeight / 2;
          f.el.style.top = `${Math.round(y)}px`;
        } else if (f.near) {
          f.el.style.top = '';
        }
        f.h = f.el.offsetHeight;
        f.cy = f.el.offsetTop + f.h / 2;
      }
    };

    const update = () => {
      const y = window.scrollY;
      const mid = y + vh / 2;
      for (const f of floats) {
        if (!f.par) continue;
        if (Math.abs(f.cy - mid) > vh * 1.6 + f.h / 2) continue; // 화면에서 먼 그림은 건너뜀
        // 화면 가운데에 왔을 때 제자리, 멀어질수록 par 비율만큼 덜 움직임
        f.el.style.translate = `0 ${(f.par * (mid - f.cy)).toFixed(1)}px`;
      }
      if (fixeds.length) {
        // 짧은 페이지(거의 스크롤이 안 되는 곳)에서 몇 px 만에 배경이 통째로 바뀌지 않도록, 진행률 기준 길이는 화면 높이의 1.5배 이상으로 잡습니다
        const p = Math.min(100, Math.max(0, (y / Math.max(docH - vh, vh * 1.5)) * 100));
        for (const x of fixeds) {
          const lo = x.from <= 0 ? 1 : clamp01((p - (x.from - RAMP / 2)) / RAMP);
          const hi = x.to >= 100 ? 1 : clamp01((x.to + RAMP / 2 - p) / RAMP);
          x.el.style.opacity = (x.op * lo * hi).toFixed(3);
        }
      }
    };

    let frame = 0;
    let needMeasure = true;
    const schedule = (remeasure = false) => {
      if (remeasure) needMeasure = true;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (needMeasure) {
          needMeasure = false;
          measure();
        }
        update();
      });
    };

    window.addEventListener('scroll', () => schedule(), { passive: true });
    window.addEventListener('resize', () => schedule(true));
    window.addEventListener('load', () => schedule(true));
    window.addEventListener('pageshow', () => schedule(true));
    if ('ResizeObserver' in window) new ResizeObserver(() => schedule(true)).observe(document.body);

    // 3) 화면에 들어오면 서서히 나타남 ('동작 줄이기'면 바로 보임)
    if (reduced || !('IntersectionObserver' in window)) {
      for (const f of floats) f.el.classList.add('is-in');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -6% 0px' },
      );
      for (const f of floats) io.observe(f.el);
    }

    measure();
    update();
    window.__bdReady = true;
  }

  try {
    start();
  } catch (err) {
    // 어떤 이유로든 실패하면 그림이 숨겨진 채로 남지 않게 '나타나기' 효과를 끕니다.
    console.error('[background]', err);
    document.documentElement.classList.remove('bd-js');
  }
</script>

<style>
  /* 글자 뒤(z-index:-1)에 문서 전체 높이로 깔리는 층. 배경색을 같은 값으로 깔아 두어 multiply 합성이 바탕색과 섞입니다 */
  .bd-root {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }
  @media print {
    .bd-root {
      display: none;
    }
  }

  /* fixed: 화면 전체에 고정 (스크롤해도 제자리, 위에 내용이 지나감) */
  .bd-fixed {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }
  .bd-fixed :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: var(--bd-fit, cover);
    object-position: var(--bd-pos, center);
  }

  /* float: 문서 위에 떠 있는 그림. 세로 위치는 자동 칸(slot) 또는 near 구역(스크립트가 top 을 덮어씀) */
  .bd {
    --bd-width: clamp(180px, var(--bd-size, 40vw), 960px);
    position: absolute;
    top: calc(var(--bd-slot, 0) * var(--bd-gap, 80vh) + 4vh);
    width: var(--bd-width);
    opacity: var(--bd-op, 0.5);
    rotate: var(--bd-rot, 0deg);
    pointer-events: none;
  }
  .bd--left {
    left: var(--bd-off, 0);
  }
  .bd--right {
    right: var(--bd-off, 0);
  }
  .bd--center {
    left: calc(50% - var(--bd-width) / 2 + var(--bd-off, 0));
  }
  .bd--par {
    will-change: translate;
  }
  .bd--multiply {
    mix-blend-mode: multiply;
  }
  .bd :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }
  .bd--fade :global(img) {
    -webkit-mask-image: radial-gradient(closest-side, #000 calc(100% - var(--bd-fade, 0%)), transparent);
    mask-image: radial-gradient(closest-side, #000 calc(100% - var(--bd-fade, 0%)), transparent);
  }
  .bd :global(img.bd__flip) {
    transform: scaleX(-1);
  }

  /* 나타나기 효과: bd-js 는 위 인라인 스크립트가 붙이고, 화면에 들어오면 스크립트가 is-in 을 붙임 */
  :global(html.bd-js) .bd {
    opacity: 0;
    scale: 1.05;
    transition:
      opacity 1.4s ease,
      scale 1.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(html.bd-js) .bd.is-in {
    opacity: var(--bd-op, 0.5);
    scale: 1;
  }
</style>
