---
// 연락처 블록 (§5.8, D27): 소속·주소·이메일·전화(dl) + 지도(구글 퍼가기 iframe 또는 이미지) + 외부 지도 링크 버튼.
// Contact 페이지(ContactView)와 Home 의 Contact 요약(HomeView)이 같이 씁니다. 값은 모두 site.yml, [TODO] 값은 TodoText.
// 배치(세로 쌓기 / 좌우 나누기)는 부모가 정합니다 — 이 컴포넌트는 dl·figure·p 세 덩어리만 그립니다.
import { Image } from 'astro:assets';
import TodoText from './TodoText.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../lib/i18n';
import { resolveAsset, responsive } from '../lib/assets';
import { address, department, isReal, linkLabel, mapLinkLabel, site } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const addr = address(locale);
const postal = site.address.postal_code;

// 지도 이미지: site.yml 의 contact.map_image (src/assets 기준 경로). 지정했는데 파일이 없으면 빌드를 멈춰 오타를 바로 알립니다.
const mapImagePath = site.contact.map_image?.trim();
const mapImage = resolveAsset(mapImagePath);
if (mapImagePath && !mapImage) {
  throw new Error(`site.yml contact.map_image 파일을 찾을 수 없습니다: src/assets/${mapImagePath.replace(/^\/?(src\/)?assets\//, '')}`);
}
// 지도 링크 버튼: contact.map_links(여러 개) 가 있으면 그것을, 없으면 contact.map_url 하나를 버튼으로 씁니다.
// 지도 퍼가기: contact.map_embed_url (구글 지도 '지도 퍼가기'의 iframe src). 구글 퍼가기 주소가 아니면 빌드를 멈춥니다.
const mapEmbed = site.contact.map_embed_url?.trim();
if (mapEmbed && !mapEmbed.startsWith('https://www.google.com/maps/embed')) {
  throw new Error('site.yml contact.map_embed_url 은 https://www.google.com/maps/embed 로 시작하는 구글 지도 퍼가기 주소여야 합니다.');
}
const mapLinks = (site.contact.map_links ?? []).filter((l) => isReal(l.url));
const mapFallback = isReal(site.contact.map_url) ? site.contact.map_url : undefined;
// 이미지를 눌렀을 때 이동할 주소: map_url 이 있으면 그것, 없으면 첫 번째 map_links
const mapTarget = mapFallback ?? mapLinks[0]?.url;
const mapLinked = !!mapTarget;
---

<dl class="dl contact__dl">
  <dt>{t('contact.affiliation')}</dt>
  <dd>
    {department(locale)}
    {
      isReal(site.links.university?.url) && (
        <>
          {' · '}
          <a href={site.links.university.url} rel="noopener">
            {linkLabel('university', locale)}
          </a>
        </>
      )
    }
  </dd>
  <dt>{t('contact.address')}</dt>
  <dd>
    <TodoText text={addr} />
    {postal && (
      <>
        <br />
        <TodoText text={postal} />
      </>
    )}
  </dd>
  <dt>{t('contact.email')}</dt>
  <dd>
    {
      isReal(site.contact.email) ? (
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      ) : (
        <TodoText text={site.contact.email} />
      )
    }
  </dd>
  <dt>{t('contact.phone')}</dt>
  <dd>
    {
      isReal(site.contact.phone) ? (
        <a href={`tel:${site.contact.phone.replace(/[^\d+]/g, '')}`}>{site.contact.phone}</a>
      ) : (
        <TodoText text={site.contact.phone} />
      )
    }
  </dd>
</dl>
{
  mapEmbed && (
    <figure class="contact__figure">
      <iframe
        class="contact__embed"
        src={mapEmbed}
        title={t('contact.map_alt')}
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      />
      <figcaption class="contact__credit muted">{t('contact.map_embed_note')}</figcaption>
    </figure>
  )
}
{
  !mapEmbed && mapImage && (
    <figure class="contact__figure">
      {mapLinked ? (
        <a class="contact__imglink" href={mapTarget} rel="noopener" aria-label={t('contact.map')}>
          <Image src={mapImage} alt={t('contact.map_alt')} width={900} {...responsive(mapImage, [480, 720, 900], '(max-width: 860px) 92vw, 560px')} />
        </a>
      ) : (
        <Image src={mapImage} alt={t('contact.map_alt')} width={900} {...responsive(mapImage, [480, 720, 900], '(max-width: 860px) 92vw, 560px')} />
      )}
      {
        isReal(site.contact.map_credit) && (
          <figcaption class="contact__credit muted">
            {isReal(site.contact.map_credit_url) ? (
              <a href={site.contact.map_credit_url} rel="noopener">
                {site.contact.map_credit}
              </a>
            ) : (
              site.contact.map_credit
            )}
          </figcaption>
        )
      }
    </figure>
  )
}
{
  (mapLinks.length > 0 || mapFallback) && (
    <p class="contact__map">
      {mapLinks.length > 0 ? (
        mapLinks.map((l) => (
          <a class="btn btn--secondary" href={l.url} rel="noopener">
            {mapLinkLabel(l, locale)}
          </a>
        ))
      ) : (
        <a class="btn btn--secondary" href={mapFallback} rel="noopener">
          {t('contact.map')}
        </a>
      )}
    </p>
  )
}

<style>
  .contact__dl {
    gap: 0.8em 1.4em;
  }
  .contact__map {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0 0;
  }
  .contact__figure {
    margin: 20px 0 0;
  }
  .contact__figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .contact__embed {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .contact__imglink {
    display: block;
    border-radius: var(--radius);
  }
  .contact__imglink:hover img {
    border-color: var(--muted-2);
  }
  .contact__credit {
    margin-top: 6px;
    font-size: var(--fs-small);
  }
</style>
