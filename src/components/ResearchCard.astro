---
// 연구 분야 카드: 대표 이미지(16:9) + 번호 라벨 + 제목 + 한 줄 요약
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import type { ResearchEntry } from '../lib/content';
import { resolveAsset, responsive } from '../lib/assets';
import { useTranslations } from '../lib/i18n';
import { href } from '../lib/url';

interface Props {
  entry: ResearchEntry;
  locale: Locale;
  headingLevel?: 2 | 3;
}
const { entry, locale, headingLevel = 3 } = Astro.props;
const t = useTranslations(locale);
const cover = resolveAsset(entry.data.cover);
const url = href(locale, `/research/${entry.data.slug}`);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card research-card">
  <a class="research-card__media" href={url} tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <Image src={cover} alt="" {...responsive(cover, [400, 800, 1200], '(max-width: 720px) 100vw, 360px')} />
      ) : (
        <div class="research-card__placeholder" />
      )
    }
  </a>
  <div class="card__body">
    <span class="label">
      {String(entry.data.order).padStart(2, '0')} · {t(`research.short.${entry.data.slug}`)}
    </span>
    <Heading class="research-card__title"><a href={url}>{entry.data.title}</a></Heading>
    <p class="research-card__summary">{entry.data.summary}</p>
  </div>
</article>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 0.15s ease;
  }
  .research-card:hover {
    border-color: var(--accent);
  }
  .research-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    background: #e9f1ee;
    overflow: hidden;
  }
  .research-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .research-card__placeholder {
    width: 100%;
    height: 100%;
  }
  .research-card__title {
    font-size: var(--fs-h3);
    margin: 8px 0 8px;
    line-height: 1.3;
  }
  .research-card__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .research-card__title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .research-card__summary {
    color: var(--muted);
    font-size: var(--fs-small);
    margin: 0;
  }
</style>
