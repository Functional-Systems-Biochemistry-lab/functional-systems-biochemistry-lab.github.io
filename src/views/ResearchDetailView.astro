---
// Research 상세 (§5.3 템플릿, 순서 고정):
// 1 제목+요약 → 2 배경 → 3 접근 방법(+workflow 그림) → 4 대표 결과(그림) → 5 관련 논문(keywords) → 6 이전/다음
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import PubList from '../components/PubList.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../lib/i18n';
import { getMembers, getResearch, splitSections } from '../lib/content';
import { resolveAsset, responsive } from '../lib/assets';
import { aliasKeySet, loadPublications } from '../lib/publications';
import { href } from '../lib/url';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const t = useTranslations(locale);

const all = await getResearch(locale);
const index = all.findIndex((r) => r.data.slug === slug);
const entry = all[index];
if (!entry) throw new Error(`research/${locale}/${slug}.md 가 없습니다.`);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

const { intro, sections } = splitSections(entry.rendered?.html ?? '');
const [background, approach, results, ...rest] = sections;
const cover = resolveAsset(entry.data.cover);

const slugs = all.map((r) => r.data.slug);
const { publications } = loadPublications(slugs);
const related = publications.filter((p) => p.tags.includes(slug)).slice(0, 5);
const relatedTotal = publications.filter((p) => p.tags.includes(slug)).length;
const aliasKeys = aliasKeySet((await getMembers()).map((m) => m.data.aliases));
---

<Base locale={locale} title={entry.data.title} description={entry.data.summary}>
  <div class="container page-head detail-head">
    <p class="label">
      <a href={href(locale, '/research')}>{t('research.label')}</a> ·
      {t('research.area_of', { n: entry.data.order, total: all.length })}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.summary}</p>
  </div>

  <section class="section">
    <div class="container detail">
      {
        cover && (
          <div class="detail__cover">
            <Image src={cover} alt={entry.data.cover_alt ?? ''} {...responsive(cover, [640, 960, 1280, 1600], '(max-width: 1120px) 100vw, 1072px')} loading="eager" />
            <p class="detail__cover-caption mono">{t('common.illustration_only')}</p>
          </div>
        )
      }

      {intro && <div class="prose" set:html={intro} />}

      {
        background && (
          <section class="detail__section">
            <h2 id="background">{background.heading || t('research.background')}</h2>
            <div class="prose" set:html={background.html} />
          </section>
        )
      }

      {
        (approach || entry.data.workflow) && (
          <section class="detail__section">
            <h2 id="approach">{approach?.heading || t('research.approach')}</h2>
            {entry.data.workflow && <Figure figure={entry.data.workflow} locale={locale} />}
            {approach && <div class="prose" set:html={approach.html} />}
          </section>
        )
      }

      {
        (results || entry.data.figures.length > 0) && (
          <section class="detail__section">
            <h2 id="results">{results?.heading || t('research.results')}</h2>
            {results && <div class="prose" set:html={results.html} />}
            {entry.data.figures.length > 0 && (
              <div class="detail__figures">
                {entry.data.figures.map((f) => (
                  <Figure figure={f} locale={locale} />
                ))}
              </div>
            )}
          </section>
        )
      }

      {
        rest.map((s) => (
          <section class="detail__section">
            <h2 id={s.id}>{s.heading}</h2>
            <div class="prose" set:html={s.html} />
          </section>
        ))
      }

      <section class="detail__section">
        <h2 id="publications">{t('research.related_pubs')}</h2>
        {
          related.length > 0 ? (
            <>
              <PubList publications={related} locale={locale} aliasKeys={aliasKeys} slugs={slugs} showYears={false} id="related-pubs" />
              <p>
                <a href={`${href(locale, '/publications')}?area=${slug}`}>
                  {t('research.all_pubs')} ({relatedTotal}) →
                </a>
              </p>
            </>
          ) : (
            <p class="empty">{t('research.no_pubs')}</p>
          )
        }
      </section>

      <nav class="prev-next" aria-label={t('research.title')}>
        {
          prev ? (
            <a class="prev-next__link" href={href(locale, `/research/${prev.data.slug}`)} rel="prev">
              <span class="label">← {t('research.prev_area')}</span>
              <span>{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="prev-next__link prev-next__link--next" href={href(locale, `/research/${next.data.slug}`)} rel="next">
              <span class="label">{t('research.next_area')} →</span>
              <span>{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </section>
</Base>

<style>
  .detail-head .label a {
    color: inherit;
    text-decoration: none;
  }
  .detail-head .label a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .detail {
    max-width: 820px;
  }
  /* D28: 표지 그림 박스 없이 그림과 캡션만 */
  .detail__cover {
    margin-bottom: 40px;
  }
  .detail__cover img {
    width: 100%;
    height: auto;
    display: block;
  }
  .detail__cover-caption {
    margin: 8px 0 0;
    padding: 8px 0 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .detail__section {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .detail__section h2 {
    font-size: var(--fs-h2-prose);
    margin-bottom: 20px;
  }
  .detail__section .figure {
    margin-bottom: 20px;
  }
  .detail__figures {
    display: grid;
    gap: 20px;
    margin-top: 20px;
  }
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  /* D28: 이전/다음은 박스 없는 글 링크. hover 는 색·밑줄만 */
  .prev-next__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 0;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .prev-next__link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .prev-next__link--next {
    text-align: right;
    align-items: flex-end;
  }
  @media (max-width: 560px) {
    .prev-next {
      grid-template-columns: 1fr;
    }
    .prev-next__link--next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
