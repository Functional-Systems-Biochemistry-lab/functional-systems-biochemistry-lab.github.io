# 복사해서 .env 로 저장하면 적용됩니다. (.env, .env.* 는 git 에 올라가지 않음. 이 예시 파일만 추적)

# 상단 "Draft — content under review" 띠.
# true 인 동안 robots.txt 는 Disallow: /, 모든 페이지에 noindex 메타가 들어갑니다.
# 공개 시 false 로 (CLAUDE.md §10 공개 체크리스트).
PUBLIC_DRAFT_BANNER=true

# 배포 주소. 비워 두면 astro.config.mjs 기본값을 씁니다:
#   SITE_URL=https://functional-systems-biochemistry-lab.github.io   BASE_PATH=/
# 다른 주소(예: 시험용 저장소)로 배포할 때만 입력합니다.
SITE_URL=
BASE_PATH=/
